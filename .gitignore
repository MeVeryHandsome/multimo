# Secrets
.env
.env.*
!.env.example

# Runtime data
/data/

# Test data: only the manifest, benchmark sets and READMEs are versioned
/testdata/*
!/testdata/README.md
!/testdata/manifest.tsv
!/testdata/benchmark/

