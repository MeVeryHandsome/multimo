# Multimo 环境变量模板
# 用法：cp .env.example .env，然后填入真实的 key。.env 已被 gitignore，不要提交。

# ---------- 部署 ----------
BACKEND_PORT=8000
FRONTEND_PORT=8080
BACKEND_MEM_LIMIT=4g
# 国内构建可改为 https://goproxy.cn,direct 和 https://registry.npmmirror.com
GOPROXY=https://proxy.golang.org,direct
NPM_REGISTRY=https://registry.npmjs.org

# ---------- 数据库（PostgreSQL 16 + pgvector）----------
# 本地直接运行后端时用 127.0.0.1；docker compose 会把它覆盖为 postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=multimo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=multimo
POSTGRES_SSLMODE=disable

# ---------- 存储 ----------
# 上传文件、抽出的关键帧、测试报告都写在这里。
# 相对路径以后端的运行目录（multimo-backend/）为准；docker compose 会覆盖为 /data 和 /testdata
DATA_DIR=./data
TESTDATA_DIR=../testdata
MAX_UPLOAD_MB=4096

# ---------- VLM：视觉理解 / 关键帧描述 / 目标识别 ----------
# OpenAI 兼容协议，调用 {VLM_BASE_URL}/chat/completions
VLM_BASE_URL=https://llm-a83bunxdj5qrt7y6.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=sk-your-aliyun-key
VLM_MODEL=qwen3.8-max
VLM_TIMEOUT_SEC=120
VLM_MAX_CONCURRENCY=4
# qwen3 系列的思考模式。false 时单帧描述约 5 秒；留空则不发送该参数（兼容其他 OpenAI 协议服务）
VLM_ENABLE_THINKING=false

# ---------- Embedding：关键帧描述与文档的向量 ----------
# 不填 BASE_URL / API_KEY 时沿用上面的 VLM 配置（阿里云同一端点）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SEC=30
EMBEDDING_MAX_CONCURRENCY=8

# ---------- Decision：意图判断 / 证据打分 / 问答裁判 ----------
# 不是 OpenAI chat 协议。调用 POST {DECISION_BASE_URL}{DECISION_PATH}，
# 请求体 {model, state, questions}，接口约定见 docs/ARCHITECTURE.md
DECISION_BASE_URL=https://api.bamboonode.dev/v1
DECISION_PATH=/decisions
DECISION_API_KEY=sk-your-bamboonode-key
DECISION_MODEL=startlux-decision-27b-autothink
DECISION_TIMEOUT_SEC=90
DECISION_MAX_CONCURRENCY=4

# ---------- AI 调用策略 ----------
# 每次调用最多尝试 1+AI_MAX_RETRIES 次（网络错误/429/5xx 指数退避重试），全部失败后走本地规则兜底
AI_MAX_RETRIES=3
AI_RETRY_BASE_MS=800
AI_FALLBACK_ENABLED=true
# 日志里输入/输出摘要的最大字符数
AI_LOG_PAYLOAD_CHARS=200

# ---------- 视频处理 ----------
# goroutine 池大小，限制同时处理的视频数，防止 OOM
WORKER_POOL_SIZE=4
FFMPEG_THREADS=2
# 场景切分阈值（ffmpeg scene score，0~1，越小抽帧越多）
KEYFRAME_SCENE_THRESHOLD=0.3
KEYFRAME_MAX_PER_VIDEO=60
KEYFRAME_MIN_INTERVAL_SEC=2
