# Multimo 环境变量模板
# 用法：cp .env.example .env，然后填入真实的 key。.env 已被 gitignore，不要提交。

# ---------- 部署 ----------
BACKEND_PORT=8000
FRONTEND_PORT=8080
BACKEND_MEM_LIMIT=4g
DETECTOR_MEM_LIMIT=6g
# 国内构建可改为 https://goproxy.cn,direct、https://registry.npmmirror.com、https://pypi.tuna.tsinghua.edu.cn/simple
GOPROXY=https://proxy.golang.org,direct
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple

# ---------- 数据库（PostgreSQL 16 + pgvector）----------
# 本地直接运行后端时用 127.0.0.1；docker compose 会把它覆盖为 postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=multimo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=multimo
POSTGRES_SSLMODE=disable

# ---------- 存储 ----------
# 上传文件、抽出的关键帧、测试报告都写在这里。
# 相对路径以后端的运行目录（multimo-backend/）为准；docker compose 会覆盖为 /data 和 /testdata
DATA_DIR=./data
TESTDATA_DIR=../testdata
MAX_UPLOAD_MB=4096

# ---------- VLM：视觉理解 / 关键帧描述 / 目标识别 ----------
# OpenAI 兼容协议，调用 {VLM_BASE_URL}/chat/completions
VLM_BASE_URL=https://llm-a83bunxdj5qrt7y6.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=sk-your-aliyun-key
VLM_MODEL=qwen3.8-max
VLM_TIMEOUT_SEC=120
VLM_MAX_CONCURRENCY=4
# qwen3 系列的思考模式。false 时单帧描述约 5 秒；留空则不发送该参数（兼容其他 OpenAI 协议服务）
VLM_ENABLE_THINKING=false

# ---------- Embedding：关键帧描述与文档的向量 ----------
# 不填 BASE_URL / API_KEY 时沿用上面的 VLM 配置（阿里云同一端点）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SEC=30
EMBEDDING_MAX_CONCURRENCY=8

# ---------- 多模态向量：以图搜图、以文搜图、视觉定位 ----------
# 阿里云 DashScope 原生接口（不是 OpenAI 兼容协议），图像和文本在同一向量空间。
# 不填 BASE_URL / API_KEY 时沿用 VLM 配置（去掉 /compatible-mode/v1 后的主机）
VISION_EMBEDDING_BASE_URL=
VISION_EMBEDDING_API_KEY=
VISION_EMBEDDING_PATH=/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
VISION_EMBEDDING_MODEL=tongyi-embedding-vision-plus-2026-03-06
VISION_EMBEDDING_DIM=1152
VISION_EMBEDDING_TIMEOUT_SEC=60
VISION_EMBEDDING_MAX_CONCURRENCY=6

# ---------- 目标检测：VisDrone 小目标检测模型（detector/ 服务）----------
# 设置后，无人机照片和视频关键帧的目标框由检测模型给出，视觉模型只写描述；
# 不设置或检测服务不可用时，由视觉模型画框。
# 本地开发（不用 Docker）时检测服务地址；docker compose 内由 DETECTOR_BASE_URL_DOCKER 决定
DETECTOR_BASE_URL=http://127.0.0.1:8010
# docker compose 中后端访问检测服务的地址：默认用 compose 里的 detector 容器；
# 有 GPU 服务器上部署的检测服务时，改成它的地址
DETECTOR_BASE_URL_DOCKER=http://detector:8000
# 可选：检测服务要求的访问密钥（detector 容器会用同一个值）
DETECTOR_API_KEY=
DETECTOR_MODEL=visdrone-yolov9e
# 置信度阈值：在 VisDrone val 中不属于评测集的 448 张图上标定，取准确率达到 85% 的最低阈值
DETECTOR_CONF=0.57
DETECTOR_TYPES=video,image
DETECTOR_TIMEOUT_SEC=60
DETECTOR_MAX_CONCURRENCY=2
# detector 容器的模型权重（首次启动时下载到数据卷；国内可把 huggingface.co 换成 hf-mirror.com）
DETECTOR_WEIGHTS_URL=https://huggingface.co/dronefreak/visdrone-yolov9e/resolve/main/best.pt
DETECTOR_IMGSZ=1024
# 构建 detector 镜像用的 PyTorch 源（GPU 版见 docker-compose.gpu.yml）
TORCH_INDEX=https://download.pytorch.org/whl/cpu

# ---------- 地图 ----------
# 前端地图的背景瓦片地址；内网环境填 none，只显示卫星底图叠加层和点位
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---------- 空间对齐 ----------
# 视觉定位做航迹平滑时，相邻两张照片之间允许的最大飞行速度（米/秒）
GEO_MAX_SPEED_MPS=25
# 卫星底图切块的边长（米），逗号分隔
GEO_TILE_SCALES=250,300,400

# ---------- Decision：意图判断 / 证据打分 / 问答裁判 ----------
# 不是 OpenAI chat 协议。调用 POST {DECISION_BASE_URL}{DECISION_PATH}，
# 请求体 {model, state, questions}，接口约定见 docs/ARCHITECTURE.md
DECISION_BASE_URL=https://app.vllm-sr.ai/v1
DECISION_PATH=/systemone
DECISION_API_KEY=sk-your-vllm-sr-key
DECISION_MODEL=vllm-sr/d3-ultra
DECISION_TIMEOUT_SEC=90
DECISION_MAX_CONCURRENCY=4

# ---------- AI 调用策略 ----------
# 每次调用最多尝试 1+AI_MAX_RETRIES 次（网络错误/429/5xx 指数退避重试），全部失败后走本地规则兜底
AI_MAX_RETRIES=3
AI_RETRY_BASE_MS=800
AI_FALLBACK_ENABLED=true
# 日志里输入/输出摘要的最大字符数
AI_LOG_PAYLOAD_CHARS=200

# ---------- 视频处理 ----------
# goroutine 池大小，限制同时处理的视频数，防止 OOM
WORKER_POOL_SIZE=4
FFMPEG_THREADS=2
# 关键帧：64x36 灰度签名的平均差异超过该值（0~1）即视为新画面。
# 连续航拍没有镜头切换，ffmpeg 场景分数只有约 0.01，所以按内容变化选帧
KEYFRAME_CHANGE_THRESHOLD=0.08
KEYFRAME_MAX_PER_VIDEO=60
KEYFRAME_MIN_INTERVAL_SEC=2
KEYFRAME_MAX_INTERVAL_SEC=15
KEYFRAME_WIDTH=1280
